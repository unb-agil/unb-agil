		{
			"name": "Get recommendation",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const academicHistory = pm.environment.get(\"academic-history\");",
							"",
							"const requestBody = {",
							"    curriculumSigaaId: academicHistory.curriculumSigaaId,",
							"    components: {",
							"        completed: academicHistory.components.completed,",
							"        remaining: academicHistory.components.remaining",
							"    }",
							"};",
							"",
							"pm.variables.set(\"requestBody\", JSON.stringify(requestBody));"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{{requestBody}}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{API_URL}}/recommendation",
					"host": [
						"{{API_URL}}"
					],
					"path": [
